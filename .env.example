# Crew — environment variables
# Copy to .env and fill in real values from the Supabase dashboard
# (Project Settings → API, and Project Settings → Database → Connection string → URI).

# Public project URL and anon key are safe to expose to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret — server-side only. Never used in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Drizzle to create/migrate tables.
DATABASE_URL=

# API server port.
PORT=5000

# Frontend (Vite) — exposed to the browser. Same project as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
